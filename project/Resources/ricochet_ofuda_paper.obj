# Thin, slightly curved ofuda paper flying forward along +Z.
mtllib oonusa.mtl
o RicochetOfudaPaper
usemtl OonusaWhite
vt 0.0 0.0
vt 1.0 0.0
vt 0.0 0.5
vt 1.0 0.5
vt 0.0 1.0
vt 1.0 1.0
vn 0.0 1.0 0.0
vn 0.0 -1.0 0.0
v -0.30  0.000 -0.72
v  0.30  0.000 -0.72
v -0.30  0.050  0.00
v  0.30  0.050  0.00
v -0.30 -0.015  0.72
v  0.30 -0.015  0.72
# Top and bottom faces keep the paper visible from an angled camera.
f 1/1/1 2/2/1 4/4/1 3/3/1
f 3/3/1 4/4/1 6/6/1 5/5/1
f 3/3/2 4/4/2 2/2/2 1/1/2
f 5/5/2 6/6/2 4/4/2 3/3/2
