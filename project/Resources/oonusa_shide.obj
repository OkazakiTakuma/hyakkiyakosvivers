# Two folded paper streamers (shide), laid in the horizontal flight plane.
mtllib oonusa.mtl
o OonusaShide
usemtl OonusaWhite
vt 0 0
vt 1 0
vt 1 1
vt 0 1
vn 0 1 0
vn 0 -1 0
# left streamer: five overlapping folds
v -0.18 0.075  0.49
v -0.62 0.075  0.49
v -0.62 0.075  0.27
v -0.18 0.075  0.27
v -0.62 0.075  0.27
