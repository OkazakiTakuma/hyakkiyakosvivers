v -0.58 0.075 -0.46
v -1.00 0.075 -0.46
v -1.00 0.075 -0.70
v -0.58 0.075 -0.70
# right streamer, mirrored
v 0.18 0.075  0.49
v 0.62 0.075  0.49
v 0.62 0.075  0.27
